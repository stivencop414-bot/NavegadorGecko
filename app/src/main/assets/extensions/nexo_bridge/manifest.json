{
  "manifest_version": 2,
  "name": "Nexo Browser Core",
  "version": "1.2.0",
  "description": "Funciones internas de Nexo Browser.",
  "browser_specific_settings": {
    "gecko": { "id": "nexo_bridge@com.ejemplo.navegador" }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ]
}
