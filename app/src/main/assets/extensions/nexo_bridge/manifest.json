{
  "manifest_version": 2,
  "name": "Nexo Native Bridge",
  "version": "1.1.0",
  "description": "Puente interno entre las páginas y Nexo Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nexo_bridge@com.ejemplo.navegador"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
