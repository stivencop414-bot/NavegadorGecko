<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <!-- Buscar dentro de la página: encima del contenido. La dirección está abajo. -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/find_in_page_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/find_previous"
            android:scaleType="center"
            android:src="@drawable/ic_nav_up" />

        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/find_next"
            android:scaleType="center"
            android:src="@drawable/ic_nav_down" />

        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/find_close"
            android:scaleType="center"
            android:src="@drawable/ic_menu_close" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/privateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="Navegación privada"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.ejemplo.navegador.PullRefreshLayout
        android:id="@+id/browserFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.ejemplo.navegador.NexoGeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/captionView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:gravity="center"
            android:maxLines="3"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/videoChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/captionsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Subtítulos en vivo"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="CC"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/miniPlayerButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:drawableStart="@drawable/ic_pip"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="@string/mini_video"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.ejemplo.navegador.PullRefreshLayout>

    <!-- Floating dock adapted from the supplied prototype; web content keeps its full viewport. -->
    <com.ejemplo.navegador.GestureDock
        android:id="@+id/browserDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <!-- Se conserva por compatibilidad (atajo a Inicio); el diseño actual
             no muestra el logo en la barra para dar espacio a la dirección. -->
        <TextView
            android:id="@+id/brandText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/tabToolsButton"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:contentDescription="Red, grupos e identidad Burner de esta pestaña"
            android:src="@drawable/ic_tab_tools"
            android:scaleType="center" />

        <EditText
            android:id="@+id/omnibox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:hint="@string/omnibox_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/clearOmniboxButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/clear_address"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textAllCaps="false"
            android:textSize="22sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/tabButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/open_tabs"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="1"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/open_menu"
            android:drawableTop="@drawable/ic_nav_menu"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Atrás"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Adelante"
            android:scaleType="center"
            android:src="@drawable/ic_nav_forward" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Inicio"
            android:scaleType="center"
            android:src="@drawable/ic_nav_home" />

        <ImageButton
            android:id="@+id/reloadButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Recargar"
            android:scaleType="center"
            android:src="@drawable/ic_nav_reload" />

        <ImageButton
            android:id="@+id/newTabButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Nueva pestaña"
            android:scaleType="center"
            android:src="@drawable/ic_nav_add" />
    </LinearLayout>
    </com.ejemplo.navegador.GestureDock>
</LinearLayout>
