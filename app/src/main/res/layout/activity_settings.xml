<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Configuración"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/defaultBrowserButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="@string/default_browser"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Apariencia"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Tema"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/themeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Color de acento"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/accentSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Tamaño del texto de las páginas"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/textSizeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/forceZoomSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Permitir zoom en todas las páginas"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Búsqueda e inicio"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Motor de búsqueda"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/searchSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/nexoHomeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Página de inicio de Nexo"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/freeSearchSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Búsqueda sin SafeSearch forzado"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Navegación"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/pullToRefreshSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Deslizar hacia abajo para recargar"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/dockGesturesSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Gestos en la barra inferior (cambiar de pestaña)"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/parallelDownloadsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Descargas en varias conexiones"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/desktopDefaultSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Versión de escritorio por defecto"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Reproducción automática"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/autoplaySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/javascriptSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="JavaScript"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Multimedia"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/smartPipSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Mini video al salir de la app"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/backgroundMediaSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Reproducción en segundo plano"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:tag="muted"
                    android:text="Puede aumentar el consumo de batería."
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Subtítulos en vivo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:tag="card">
                <Switch
                    android:id="@+id/captionsEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Botón CC en los videos"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/captionsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:tag="muted"
                    android:textSize="12.5sp" />
                <Button
                    android:id="@+id/configureCaptionsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Configurar subtítulos y traducción"
                    android:textAllCaps="false"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Traducción"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Traducir páginas a"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/translatorTargetSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Privacidad y seguridad"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/trackingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Protección contra rastreo"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/strictTrackingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Protección estricta"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/safeBrowsingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Avisar de sitios peligrosos"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/fingerprintingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Bloquear huellas digitales"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/queryStrippingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Quitar rastreo de los enlaces"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/gpcSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Global Privacy Control (GPC)"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <Switch
                    android:id="@+id/httpsOnlySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Solo conexiones HTTPS"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Cookies"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/cookiesSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="DNS seguro"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/dnsSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Pestañas"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/restoreTabsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Restaurar pestañas al abrir Nexo"
                    android:textSize="15sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Pestañas activas en memoria"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/liveTabsSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Datos de navegación"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/clearOnExitSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Borrar cookies, caché e historial al salir"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/clearDataButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Borrar datos de navegación ahora"
                android:textAllCaps="false"
                android:textSize="14.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="section"
                android:text="Avanzado"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:tag="card">
                <Switch
                    android:id="@+id/remoteDebugSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:switchPadding="16dp"
                    android:text="Depuración remota (USB)"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/perfLogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mediciones de rendimiento" />
            <Button
                android:id="@+id/legacyImportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Traer datos de Nexo anterior" />
            <Button
                android:id="@+id/transferProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Copia cifrada del perfil (incluye extensiones)" />
            <TextView
                android:id="@+id/aboutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:tag="muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/settingsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
