<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView android:id="@+id/settingsTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Configuración" android:textSize="28sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Apariencia" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Tema" />
        <Spinner android:id="@+id/themeSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Color de acento" />
        <Spinner android:id="@+id/accentSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Búsqueda" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Motor de búsqueda" />
        <Spinner android:id="@+id/searchSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <Switch android:id="@+id/freeSearchSwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Búsqueda libre · no forzar SafeSearch cuando el motor lo permita" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Privacidad y red" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="DNS" />
        <Spinner android:id="@+id/dnsSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Cookies" />
        <Spinner android:id="@+id/cookiesSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <Switch android:id="@+id/trackingSwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Protección contra rastreo" />
        <Switch android:id="@+id/gpcSwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Global Privacy Control" />
        <Switch android:id="@+id/httpsOnlySwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Modo solo HTTPS" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Pestañas y rendimiento" android:textStyle="bold" />
        <Switch android:id="@+id/restoreTabsSwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Restaurar pestañas y estado de navegación" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Pestañas vivas máximas" />
        <Spinner android:id="@+id/liveTabsSpinner"
            android:layout_width="match_parent" android:layout_height="48dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Página de inicio" />
        <EditText android:id="@+id/homePageEdit"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="textUri" android:singleLine="true" />

        <Switch android:id="@+id/badgeSwitch"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Mostrar indicador del puente Nexo" />

        <Button android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="16dp" android:text="Guardar cambios"
            android:textAllCaps="false" />
        <Button android:id="@+id/clearDataButton"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Borrar cookies, caché, miniaturas e historial"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
