<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/storeTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Tienda de extensiones"
            android:textSize="26sp" android:textStyle="bold" />
        <Button android:id="@+id/installedExtensionsButton"
            android:layout_width="wrap_content" android:layout_height="42dp"
            android:text="Instaladas" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/storeSubtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Mozilla Add-ons · compatibles con Android" android:textSize="13sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <EditText android:id="@+id/storeSearch"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:hint="Buscar extensión"
            android:imeOptions="actionSearch" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:singleLine="true" />
        <Button android:id="@+id/storeSearchButton"
            android:layout_width="88dp" android:layout_height="46dp"
            android:layout_marginStart="7dp" android:text="Buscar"
            android:textAllCaps="false" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/recommendedButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:text="Recomendadas" android:textAllCaps="false" />
            <Button android:id="@+id/privacyButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="6dp" android:text="Privacidad"
                android:textAllCaps="false" />
            <Button android:id="@+id/blockersButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="6dp" android:text="Bloqueadores"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/storeStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:text="Cargando…" android:textSize="12.5sp" />
    <ProgressBar android:id="@+id/storeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="5dp" android:visibility="gone" />
    <ListView android:id="@+id/storeList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="9dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="14dp" />
</LinearLayout>
