<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/storeTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tienda de extensiones" android:textSize="27sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/storeSubtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Mozilla Add-ons · extensiones compatibles con Android"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
        <EditText android:id="@+id/storeSearch"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:hint="Buscar extensión"
            android:imeOptions="actionSearch" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:singleLine="true" />
        <Button android:id="@+id/storeSearchButton"
            android:layout_width="94dp" android:layout_height="48dp"
            android:layout_marginStart="7dp" android:text="Buscar"
            android:textAllCaps="false" />
    </LinearLayout>

    <ProgressBar android:id="@+id/storeProgress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />

    <ListView android:id="@+id/storeList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
