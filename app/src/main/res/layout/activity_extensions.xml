<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/extensionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/extensionsTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Extensiones" android:textSize="27sp" android:textStyle="bold" />
    <TextView android:id="@+id/extensionsInfo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tienda AMO, importar XPI firmado, instalar por URL y administrar." />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/storeButton"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="Tienda" android:textAllCaps="false" />
        <Button android:id="@+id/importButton"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_marginStart="5dp" android:layout_weight="1"
            android:text="Importar XPI" android:textAllCaps="false" />
        <Button android:id="@+id/urlInstallButton"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_marginStart="5dp" android:layout_weight="1"
            android:text="URL" android:textAllCaps="false" />
    </LinearLayout>
    <ProgressBar android:id="@+id/extensionsProgress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />
    <ListView android:id="@+id/extensionsList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp" android:layout_weight="1" />
</LinearLayout>
