<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/extensionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:id="@+id/extensionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extensiones"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/extensionsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Instala desde Mozilla, importa un XPI firmado o administra tus extensiones."
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/storeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Tienda"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="XPI local"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/urlInstallButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="URL"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/extensionsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Cargando…"
        android:textSize="12.5sp" />

    <ProgressBar
        android:id="@+id/extensionsProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/extensionsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="14dp" />
</LinearLayout>
