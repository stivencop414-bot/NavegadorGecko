        <item name="android:textColorPrimary">@color/nexo_dark_text</item>
    </style>

    <style name="Theme.Nexo.Light.Violet" parent="Theme.Nexo.Base.Light">
        <item name="android:colorAccent">#7C3AED</item>
        <item name="android:colorPrimary">#7C3AED</item>
        <item name="android:colorControlActivated">#7C3AED</item>
        <item name="android:textColorHighlight">#7C3AED55</item>
    </style>

